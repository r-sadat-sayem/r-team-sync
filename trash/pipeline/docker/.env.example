# ============================================================
# TeamSync AI — Environment Variables
# Copy this file to .env at the project root and fill in values.
# NEVER commit .env to Git.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=n8n
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=teamsync

# ── n8n ──────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_N8N_ADMIN_PASSWORD
# n8n API key (generate in n8n UI: Settings → API → Create API Key)
N8N_API_KEY=
# Public URL where n8n is reachable (for webhook URLs in emails, etc.)
N8N_PUBLIC_URL=http://localhost:5678
# Chat webhook ID (shown in the Chat Trigger node URL after import)
N8N_CHAT_WEBHOOK_ID=unified-webhook-id
# Full chat URL injected into demo page
N8N_CHAT_URL=/webhook/${N8N_CHAT_WEBHOOK_ID}/chat

# ── FastAPI Backend ───────────────────────────────────────────
# API key used by the frontend to authenticate with the backend
BACKEND_API_KEY=CHANGE_ME_API_KEY
BACKEND_DEBUG=false
# Database URL for SQLAlchemy (auto-built from DB_* vars above in config.py,
# but can be overridden here)
# DATABASE_URL=postgresql+asyncpg://n8n:password@postgres:5432/teamsync

# ── Ollama (local dev fallback only — team uses Rakuten AI Gateway) ───────────
# Only needed if AI_PROVIDER=ollama. Use host.docker.internal on macOS/Windows.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:latest

# ── Rakuten AI Gateway ────────────────────────────────────────────────────────
# Your Rakuten AI Gateway subscription key (format: raik-...)
RAKUTEN_AI_GATEWAY_KEY=
# Provider for FastAPI backend: rakuten_claude | rakuten_openai | rakuten_llm | ollama
AI_PROVIDER=rakuten_claude
# Anthropic (Claude) via Rakuten — uses auth_token, NOT api_key
RAKUTEN_ANTHROPIC_BASE_URL=https://api.ai.public.rakuten-it.com/anthropic/
RAKUTEN_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OpenAI models via Rakuten
RAKUTEN_OPENAI_BASE_URL=https://api.ai.public.rakuten-it.com/openai/v1
RAKUTEN_OPENAI_MODEL=gpt-4.1
# Rakuten native LLMs (used in n8n workflow via OpenAI-compatible endpoint)
RAKUTEN_LLM_BASE_URL=https://api.ai.public.rakuten-it.com/rakutenllms/v1/
RAKUTEN_LLM_MODEL=rakutenai-3.0

# ── Gmail (configured in n8n Credentials Manager, not here) ──
# These are noted for reference — actual OAuth is handled in n8n UI.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=

# ── JIRA (configured in n8n Credentials Manager, not here) ───
# These are noted for reference — actual credentials are in n8n UI.
# JIRA_HOST=https://your-org.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA project key (used as fallback if not hardcoded in workflow)
JIRA_PROJECT_KEY=TSA

# ── Demo page ─────────────────────────────────────────────────
DEMO_TITLE=TeamSync AI
DEMO_BADGE=Internal Build
N8N_UPSTREAM_BASE=http://host.docker.internal:5678

# ── Production deployment (used by deploy.sh) ─────────────────
DEPLOY_HOST=
DEPLOY_USER=deploy
DEPLOY_PATH=/opt/teamsync
DEPLOY_SSH_KEY=~/.ssh/id_rsa

# ── Backup ────────────────────────────────────────────────────
BACKUP_RETAIN_DAYS=30

# ── Logging ───────────────────────────────────────────────────
N8N_LOG_LEVEL=info
LOG_LEVEL=info
