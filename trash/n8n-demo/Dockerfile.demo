FROM nginx:1.27-alpine

ENV N8N_CHAT_URL=""
ENV DEMO_TITLE="TeamSync AI"
ENV DEMO_BADGE="Public Review Build"

COPY docker/demo-nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/entrypoint.sh /docker-entrypoint.d/40-generate-config.sh

COPY demo.html /usr/share/nginx/html/index.html
COPY DEMO_GUIDE.md /usr/share/nginx/html/DEMO_GUIDE.md
COPY TESTING_GUIDE.md /usr/share/nginx/html/TESTING_GUIDE.md
COPY E2E_TEST_DATA.md /usr/share/nginx/html/E2E_TEST_DATA.md
COPY DEMO_DOCKER.md /usr/share/nginx/html/DEMO_DOCKER.md

RUN chmod +x /docker-entrypoint.d/40-generate-config.sh

EXPOSE 4040
