# TeamSync AI — Python FastAPI backend
# Multi-stage: development (hot-reload) and production (optimized)

# ── Base ──────────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System deps (asyncpg needs libpq, cryptography needs libssl)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc curl \
    && rm -rf /var/lib/apt/lists/*

# ── Development ───────────────────────────────────────────────────────────────
FROM base AS development

COPY requirements.txt requirements-dev.txt ./
RUN pip install -r requirements-dev.txt

# Source mounted as volume in docker-compose.dev.yml — not copied here
EXPOSE 8000
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# ── Production build ──────────────────────────────────────────────────────────
FROM base AS production

COPY requirements.txt ./
RUN pip install -r requirements.txt

COPY src/ ./src/
COPY alembic/ ./alembic/ 2>/dev/null || true
COPY alembic.ini ./alembic.ini 2>/dev/null || true

# Non-root user for security
RUN useradd --system --no-create-home appuser && chown -R appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "2", "--access-log"]
