# TeamSync v2.0 — environment variables
# Copy to .env and fill in values. Never commit .env.

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://teamsync:teamsync@localhost:5432/teamsync

# ── Rakuten AI Gateway ────────────────────────────────────────
RAKUTEN_AI_GATEWAY_KEY=raik-your-key-here
RAKUTEN_ANTHROPIC_BASE_URL=https://api.ai.public.rakuten-it.com/anthropic/
RAKUTEN_ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# ── API auth ──────────────────────────────────────────────────
# Shared key the frontend sends in X-API-Key header
BACKEND_API_KEY=dev-change-me

# ── App ───────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=info

# ── Gmail OAuth 2.0 (preferred — user logs in via popup) ──────
# Setup: console.cloud.google.com → Enable Gmail API
#   → Credentials → OAuth 2.0 Client ID (Web application)
#   Callback URL: http://localhost:8000/api/v1/email/auth/callback
#   Scopes: gmail.send + userinfo.email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Gmail SMTP App Password (fallback if OAuth not configured) ─
GMAIL_SENDER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── JIRA OAuth 2.0 (preferred — user-level access) ────────────
# Setup: https://developer.atlassian.com/console/myapps/ → Create OAuth 2.0 app
#   Callback URL: http://localhost:8000/api/v1/jira/auth/callback
#   Scopes: read:jira-work  write:jira-work  offline_access
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# ── JIRA API key fallback (service account, used if no OAuth) ─
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=TSA
# Issue type names — adjust if your project uses Task/Sub-task instead of Story/Subtask
JIRA_EPIC_TYPE=Epic
JIRA_STORY_TYPE=Story
JIRA_SUBTASK_TYPE=Subtask
